<div id="status-panel" class="w-full bg-[#1A1008] border-b border-cyan-500/30 px-4 py-2.5 flex items-center justify-between text-sm font-mono sticky top-0 z-50 shadow-lg">
  <!-- Ліва частина: Кнопка ПОСВІДКА -->
  <button onclick="alert('Відкриття Посвідки / Перехід на головну')" class="px-3 py-1 bg-cyan-950/60 border border-cyan-500/40 text-cyan-300 hover:bg-cyan-900/50 transition flex items-center space-x-1.5 rounded-none">
    <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
    <span class="font-bold tracking-wider">ПОСВІДКА</span>
  </button>

  <!-- Центр: Marquee-рядок (Біжучий рядок тривог і новин) -->
  <div class="hidden md:flex overflow-hidden whitespace-nowrap max-w-xl text-[#00FF41] text-xs uppercase tracking-widest px-4">
    <div class="animate-marquee inline-block">
      🟢 СИСТЕМА У СТАДІЇ P2P-ЗХИСТУ • СТАТУС ТРИВОГ: НОРМА • ТРИМАЄМО ЗВ'ЯЗОК, КОЛИ ВСЕ ІНШЕ МОВЧИТЬ •
    </div>
  </div>

  <!-- Права частина: Кнопка SOS -->
  <button id="sos-trigger-btn" class="px-3 py-1 bg-red-950 border border-red-600 text-red-300 hover:bg-red-900 transition flex items-center space-x-1.5 animate-pulse rounded-none">
    <span class="w-2 h-2 rounded-full bg-red-500 animate-ping"></span>
    <span class="font-extrabold tracking-widest text-white">SOS</span>
  </button>
</div>

<!-- Модальне вікно (Bottom-Sheet) екстреного виклику SOS -->
<div id="sos-modal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 hidden flex items-end md:items-center justify-center p-0 md:p-4">
  <div class="bg-[#1A1008] border-2 border-red-700 w-full max-w-lg p-6 space-y-4 shadow-2xl relative">
    <div class="flex justify-between items-center border-b border-red-900/50 pb-3">
      <h3 class="text-red-500 font-extrabold tracking-wider text-lg flex items-center space-x-2">
        <span>🚨 ЕКСТРЕНИЙ ПРОТОКОЛ SOS</span>
      </h3>
      <button id="sos-close-btn" class="text-zinc-400 hover:text-white font-mono text-xl">✕</button>
    </div>

    <p class="text-xs text-zinc-300 font-mono">
      Миттєва розсилка сигналу з вашими GPS-координатами на 5 довірених контактів за Community ID та через захищені канали.
    </p>

    <div class="grid grid-cols-1 gap-2.5 pt-2">
      <a href="tel:112" class="p-3 bg-red-950/40 border border-red-800/60 text-white flex justify-between items-center hover:bg-red-900/40 transition">
        <span class="font-bold">📞 112 — Єдина рятувальна служба</span>
        <span class="text-xs text-red-400 font-mono">Дзвінок</span>
      </a>
      <button onclick="triggerSosBroadcast()" class="p-3 bg-red-700 hover:bg-red-600 text-white font-bold tracking-wider flex justify-between items-center transition shadow-lg">
        <span>🆘 РОЗІСЛАТИ 5 КОНТАКТАМ (GPS)</span>
        <span class="text-xs font-mono bg-black/30 px-2 py-0.5">Cooldown: 5 хв</span>
      </button>
    </div>

    <div class="pt-2 text-center">
      <p id="sos-status-msg" class="text-xs text-cyan-400 font-mono hidden">Сигнал успішно зашифровано та відправлено по P2P-мережі!</p>
    </div>
  </div>
</div>

<script>
  const sosBtn = document.getElementById('sos-trigger-btn');
  const sosModal = document.getElementById('sos-modal');
  const closeBtn = document.getElementById('sos-close-btn');

  sosBtn?.addEventListener('click', () => {
    sosModal?.classList.remove('hidden');
  });

  closeBtn?.addEventListener('click', () => {
    sosModal?.classList.add('hidden');
  });

  window.triggerSosBroadcast = function() {
    const msg = document.getElementById('sos-status-msg');
    if (msg) {
      msg.classList.remove('hidden');
      setTimeout(() => {
        sosModal?.classList.add('hidden');
        msg.classList.add('hidden');
      }, 2500);
    }
  }
</script>
