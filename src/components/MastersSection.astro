---
// Компонент розділу "Фахівці" для сайту Голосник
---

<section class="w-full py-16 px-6 bg-[#0A1118] border-t border-cyan-500/20">
  <div class="max-w-6xl mx-auto space-y-8">
    
    <!-- Заголовок розділу -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-cyan-500/20 pb-4">
      <div>
        <span class="text-xs font-mono uppercase tracking-widest text-cyan-400 bg-cyan-950/40 px-3 py-1 border border-cyan-500/30">
          Маркетплейс громад
        </span>
        <h2 class="text-3xl md:text-4xl font-extrabold text-white mt-2 font-mono">
          КАТАЛОГ ФАХІВЦІВ
        </h2>
      </div>
      
      <!-- Перемикач УСІ / МОЇ -->
      <div class="flex items-center space-x-2 font-mono text-sm">
        <button class="px-4 py-2 bg-cyan-500 text-black font-bold border border-cyan-400 rounded-none">
          [ УСІ ]
        </button>
        <button class="px-4 py-2 bg-cyan-950/40 text-cyan-300 border border-cyan-500/30 hover:bg-cyan-900/50 rounded-none">
          [ ⭐ МОЇ (0) ]
        </button>
      </div>
    </div>

    <!-- Фільтри за сферами -->
    <div class="flex flex-wrap gap-2 text-xs font-mono">
      <span class="px-3 py-1.5 bg-cyan-500/20 text-cyan-300 border border-cyan-500/40 cursor-pointer">УСІ</span>
      <span class="px-3 py-1.5 bg-cyan-950/40 text-cyan-200/70 border border-cyan-500/20 hover:border-cyan-500/40 cursor-pointer">МЕДИЦИНА</span>
      <span class="px-3 py-1.5 bg-cyan-950/40 text-cyan-200/70 border border-cyan-500/20 hover:border-cyan-500/40 cursor-pointer">ПРАВО</span>
      <span class="px-3 py-1.5 bg-cyan-950/40 text-cyan-200/70 border border-cyan-500/20 hover:border-cyan-500/40 cursor-pointer">ТЕХНІКА</span>
      <span class="px-3 py-1.5 bg-cyan-950/40 text-cyan-200/70 border border-cyan-500/20 hover:border-cyan-500/40 cursor-pointer">БІЗНЕС</span>
    </div>

    <!-- Сітка карток фахівців -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      
      <!-- Картка фахівця 1 -->
      <div class="bg-[#121C24] border border-cyan-500/30 p-5 flex flex-col justify-between space-y-4 relative group hover:border-cyan-400 transition">
        <div class="flex items-start justify-between">
          <div class="flex items-center space-x-3">
            <div class="w-12 h-12 bg-cyan-950 border border-cyan-500/40 flex items-center justify-center text-cyan-300 font-mono font-bold text-lg">
              ЛК
            </div>
            <div>
              <div class="flex items-center space-x-2">
                <h3 class="font-bold text-white font-mono">Людмила Коваль</h3>
                <span class="text-[10px] bg-green-950 text-green-400 border border-green-700 px-1.5 py-0.5 font-mono">ФОП</span>
              </div>
              <p class="text-xs text-cyan-300/70 font-mono">Сімейний лікар • Київ</p>
            </div>
          </div>
          <button class="text-zinc-500 hover:text-yellow-400 transition text-lg">⭐</button>
        </div>

        <div class="flex items-center justify-between text-xs font-mono text-zinc-400 border-t border-cyan-500/10 pt-3">
          <span class="flex items-center space-x-1 text-green-400">
            <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
            <span>Онлайн</span>
          </span>
          <span class="text-yellow-400 font-bold">⭐ 4.9 (124)</span>
        </div>

        <!-- Кнопки зв'язку за активними модулями -->
        <div class="grid grid-cols-4 gap-1 pt-1 text-xs font-mono">
          <button class="py-2 bg-cyan-950/60 border border-cyan-500/30 text-cyan-300 hover:bg-cyan-900/50">ЧАТ</button>
          <button class="py-2 bg-cyan-950/60 border border-cyan-500/30 text-cyan-300 hover:bg-cyan-900/50">ГОЛОС</button>
          <button class="py-2 bg-cyan-950/60 border border-cyan-500/30 text-cyan-300 hover:bg-cyan-900/50">ВІДЕО</button>
          <button class="py-2 bg-purple-950/60 border border-purple-500/30 text-purple-300 hover:bg-purple-900/50">🤖 ШІ</button>
        </div>
      </div>

      <!-- Картка фахівця 2 -->
      <div class="bg-[#121C24] border border-cyan-500/30 p-5 flex flex-col justify-between space-y-4 relative group hover:border-cyan-400 transition">
        <div class="flex items-start justify-between">
          <div class="flex items-center space-x-3">
            <div class="w-12 h-12 bg-cyan-950 border border-cyan-500/40 flex items-center justify-center text-cyan-300 font-mono font-bold text-lg">
              МП
            </div>
            <div>
              <div class="flex items-center space-x-2">
                <h3 class="font-bold text-white font-mono">Марко Потапенко</h3>
                <span class="text-[10px] bg-green-950 text-green-400 border border-green-700 px-1.5 py-0.5 font-mono">ФОП</span>
              </div>
              <p class="text-xs text-cyan-300/70 font-mono">Юрист з безпеки • Харків</p>
            </div>
          </div>
          <button class="text-zinc-500 hover:text-yellow-400 transition text-lg">⭐</button>
        </div>

        <div class="flex items-center justify-between text-xs font-mono text-zinc-400 border-t border-cyan-500/10 pt-3">
          <span class="flex items-center space-x-1 text-zinc-500">
            <span class="w-2 h-2 rounded-full bg-zinc-600"></span>
            <span>Офлайн</span>
          </span>
          <span class="text-yellow-400 font-bold">⭐ 4.8 (89)</span>
        </div>

        <div class="grid grid-cols-4 gap-1 pt-1 text-xs font-mono">
          <button class="py-2 bg-cyan-950/60 border border-cyan-500/30 text-cyan-300 hover:bg-cyan-900/50">ЧАТ</button>
          <button class="py-2 bg-cyan-950/60 border border-cyan-500/30 text-cyan-300 hover:bg-cyan-900/50">ГОЛОС</button>
          <button class="py-2 bg-cyan-950/60 border border-cyan-500/30 text-cyan-300 hover:bg-cyan-900/50">ВІДЕО</button>
          <button class="py-2 bg-purple-950/60 border border-purple-500/30 text-purple-300 hover:bg-purple-900/50">🤖 ШІ</button>
        </div>
      </div>

      <!-- Картка фахівця 3 -->
      <div class="bg-[#121C24] border border-cyan-500/30 p-5 flex flex-col justify-between space-y-4 relative group hover:border-cyan-400 transition">
        <div class="flex items-start justify-between">
          <div class="flex items-center space-x-3">
            <div class="w-12 h-12 bg-cyan-950 border border-cyan-500/40 flex items-center justify-center text-cyan-300 font-mono font-bold text-lg">
              ОБ
            </div>
            <div>
              <div class="flex items-center space-x-2">
                <h3 class="font-bold text-white font-mono">Олег Бондар</h3>
                <span class="text-[10px] bg-green-950 text-green-400 border border-green-700 px-1.5 py-0.5 font-mono">ФОП</span>
              </div>
              <p class="text-xs text-cyan-300/70 font-mono">Енергонезалежність • Одеса</p>
            </div>
          </div>
          <button class="text-zinc-500 hover:text-yellow-400 transition text-lg">⭐</button>
        </div>

        <div class="flex items-center justify-between text-xs font-mono text-zinc-400 border-t border-cyan-500/10 pt-3">
          <span class="flex items-center space-x-1 text-green-400">
            <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
            <span>Онлайн</span>
          </span>
          <span class="text-yellow-400 font-bold">⭐ 5.0 (210)</span>
        </div>

        <div class="grid grid-cols-4 gap-1 pt-1 text-xs font-mono">
          <button class="py-2 bg-cyan-950/60 border border-cyan-500/30 text-cyan-300 hover:bg-cyan-900/50">ЧАТ</button>
          <button class="py-2 bg-cyan-950/60 border border-cyan-500/30 text-cyan-300 hover:bg-cyan-900/50">ГОЛОС</button>
          <button class="py-2 bg-cyan-950/60 border border-cyan-500/30 text-cyan-300 hover:bg-cyan-900/50">ВІДЕО</button>
          <button class="py-2 bg-purple-950/60 border border-purple-500/30 text-purple-300 hover:bg-purple-900/50">🤖 ШІ</button>
        </div>
      </div>

    </div>

    <!-- Кнопка реєстрації бізнесу -->
    <div class="pt-4 text-center">
      <button class="px-6 py-3 bg-gradient-to-r from-cyan-600 to-blue-600 text-white font-bold font-mono tracking-wider border border-cyan-400/50 shadow-lg hover:brightness-110 transition">
        🏢 ЗАРЕЄСТРУВАТИ СВІЙ БІЗНЕС / ФОП
      </button>
    </div>

  </div>
</section>
